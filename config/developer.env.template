# Copy to config/developer.env and fill in your Apple Developer values.
# config/developer.env is gitignored — never commit real credentials.

# Full codesign identity (from: security find-identity -v -p codesigning)
DEVELOPER_ID="Developer ID Application: YOUR NAME (TEAM_ID)"

# Apple Developer Team ID (10 characters)
APPLE_TEAM_ID="YOUR_TEAM_ID"

# Apple ID email used for notarization
APPLE_ID="your-apple-id@example.com"

# Keychain profile name for xcrun notarytool (create once via store-credentials)
KEYCHAIN_PROFILE="your-notary-profile"
